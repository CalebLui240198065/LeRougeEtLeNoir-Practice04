<?xml version="1.0" encoding="utf-8"?>
<!-- Match each of the square backgrounds, giving the winning state priority over marked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/ink" />
    <item android:state_selected="true" android:color="@color/cream" />
    <item android:state_enabled="true" android:color="@color/red_dark" />
    <item android:color="@color/ink_muted" />
</selector>
