<?xml version="1.0" encoding="utf-8"?>
<!-- The ink card gives light type and gold accents a high contrast surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ink_soft" />
    <corners android:radius="@dimen/card_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/line_dark" />
</shape>
