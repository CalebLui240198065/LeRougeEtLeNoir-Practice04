<?xml version="1.0" encoding="utf-8"?>
<!-- The light icon button provides a bounded touch target on parchment. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brown_pale">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/cream" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</ripple>
