<?xml version="1.0" encoding="utf-8"?>
<!-- Separate current, new, and confirmation fields let SettingsActivity report specific errors. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.14"
            android:text="@string/settings_password_eyebrow"
            android:textColor="@color/brown"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:fontFamily="@font/cormorant_semibold"
            android:text="@string/settings_password_title"
            android:textColor="@color/ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:fontFamily="@font/nunito_regular"
            android:text="@string/settings_password_message"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.08"
            android:text="@string/settings_current_password"
            android:textColor="@color/ink"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/currentPasswordInput"
            style="@style/Widget.RougeNoir.Input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:autofillHints="password"
            android:imeOptions="actionNext"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.08"
            android:text="@string/settings_new_password"
            android:textColor="@color/ink"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/newPasswordInput"
            style="@style/Widget.RougeNoir.Input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:autofillHints="newPassword"
            android:imeOptions="actionNext"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:fontFamily="@font/nunito_bold"
            android:letterSpacing="0.08"
            android:text="@string/settings_confirm_password"
            android:textColor="@color/ink"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            style="@style/Widget.RougeNoir.Input"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:autofillHints="newPassword"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/passwordError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:fontFamily="@font/nunito_semibold"
            android:textColor="@color/red"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:fontFamily="@font/nunito_regular"
            android:text="@string/settings_demo_password_note"
            android:textColor="@color/muted_light"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancelPasswordButton"
                style="@style/Widget.RougeNoir.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textSize="10sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/savePasswordButton"
                style="@style/Widget.RougeNoir.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/settings_password_save"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
