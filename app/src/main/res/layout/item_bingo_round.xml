<?xml version="1.0" encoding="utf-8"?>
<!-- One saved result in the history list, with winning numbers in board order. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/bingoHistoryRound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RougeNoir.Label"
        android:textColor="@color/red_dark" />

    <TextView
        android:id="@+id/bingoHistoryNumbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.RougeNoir.Title" />

    <TextView
        android:id="@+id/bingoHistoryDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.RougeNoir.BodySmall" />
</LinearLayout>
