<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <ScrollView
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_paper"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:paddingStart="24dp"
                android:paddingTop="18dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <View
                    android:layout_width="146dp"
                    android:layout_height="146dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.11"
                    android:background="@drawable/bg_dot_red" />

                <LinearLayout
                    android:id="@+id/menuTopRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.18"
                            android:text="@string/menu_eyebrow"
                            android:textColor="@color/gold_light"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/menuGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            app:fontFamily="@font/nunito_regular"
                            android:textColor="@color/parchment"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/profileSeal"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_profile_seal"
                        android:contentDescription="@string/content_description_profile"
                        app:fontFamily="@font/cormorant_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingTop="2dp"
                        android:textColor="@color/cream"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/menuTopRow"
                    android:layout_marginTop="8dp"
                    app:fontFamily="@font/cormorant_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/menu_title"
                    android:textColor="@color/cream"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/menuSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/menuTitle"
                    app:fontFamily="@font/nunito_regular"
                    android:text="@string/menu_subtitle"
                    android:textColor="@color/parchment"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/menuStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/menuSubtitle"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_pill"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.08"
                            android:text="@string/menu_stat_duels"
                            android:textColor="@color/gold_light"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/statDuels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/cream"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_pill"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.08"
                            android:text="@string/menu_stat_serpent"
                            android:textColor="@color/gold_light"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/statSnake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/cream"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_pill"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.08"
                            android:text="@string/menu_stat_wall"
                            android:textColor="@color/gold_light"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/statWall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/cream"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- History sits with the game choices because it covers every game. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_section_games"
                    android:textAppearance="@style/TextAppearance.RougeNoir.Eyebrow" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/menuRoundHistory"
                    style="@style/Widget.RougeNoir.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/history_title" />
            </LinearLayout>

            <!-- The new Bingo game sits above the original practice games. -->
            <LinearLayout
                android:id="@+id/gameBingoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bingo_title"
                        android:textAppearance="@style/TextAppearance.RougeNoir.DisplaySmall"
                        android:textColor="@color/cream" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bingo_menu_description"
                        android:textAppearance="@style/TextAppearance.RougeNoir.Body"
                        android:textColor="@color/parchment" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_art_well_gold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minWidth="72dp"
                    android:minHeight="54dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/bingo_menu_emblem"
                    android:textAppearance="@style/TextAppearance.RougeNoir.Title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gameTttCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_red"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.08"
                        android:paddingStart="7dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="3dp"
                        android:text="@string/game_ttt_kicker"
                        android:textColor="@color/red_dark"
                        android:textSize="7sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:fontFamily="@font/cormorant_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.92"
                        android:text="@string/game_ttt_title"
                        android:textColor="@color/ink"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:fontFamily="@font/nunito_regular"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/game_ttt_desc"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.12"
                            android:text="@string/game_enter"
                            android:textColor="@color/red"
                            android:textSize="9sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="3dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/red" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="114dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_art_well_red"
                    android:padding="7dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/content_description_ttt_art"
                        android:scaleType="fitCenter"
                        android:src="@drawable/art_three_estates" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/gameSnakeCard"
                    android:layout_width="0dp"
                    android:layout_height="272dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/bg_art_well_brown"
                        android:padding="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/content_description_snake_art"
                            android:scaleType="fitCenter"
                            android:src="@drawable/art_serpent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.06"
                        android:text="@string/game_snake_kicker"
                        android:textColor="@color/brown"
                        android:textSize="7sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:fontFamily="@font/cormorant_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.88"
                        android:text="@string/game_snake_title"
                        android:textColor="@color/ink"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:fontFamily="@font/nunito_regular"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/game_snake_desc"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.1"
                            android:text="@string/game_enter"
                            android:textColor="@color/red"
                            android:textSize="8sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/red" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gameBreakoutCard"
                    android:layout_width="0dp"
                    android:layout_height="272dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/bg_art_well_gold"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/content_description_breakout_art"
                            android:scaleType="fitCenter"
                            android:src="@drawable/art_breakout" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.06"
                        android:text="@string/game_breakout_kicker"
                        android:textColor="@color/brown"
                        android:textSize="7sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:fontFamily="@font/cormorant_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.88"
                        android:text="@string/game_breakout_title"
                        android:textColor="@color/ink"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        app:fontFamily="@font/nunito_regular"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/game_breakout_desc"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.1"
                            android:text="@string/game_enter"
                            android:textColor="@color/red"
                            android:textSize="8sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/red" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card_dark"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:contentDescription="@string/content_description_settings_art"
                    android:scaleType="fitCenter"
                    android:src="@drawable/art_study" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.14"
                        android:text="@string/settings_eyebrow"
                        android:textColor="@color/gold_light"
                        android:textSize="8sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        app:fontFamily="@font/cormorant_semibold"
                        android:text="@string/menu_config_title"
                        android:textColor="@color/cream"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_regular"
                        android:text="@string/menu_config_desc"
                        android:textColor="@color/parchment"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/gold_light" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/cormorant_semibold"
                    android:gravity="center"
                    android:text="@string/menu_footer"
                    android:textColor="@color/brown"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:fontFamily="@font/nunito_regular"
                    android:text="@string/menu_footer_source"
                    android:textColor="@color/muted_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
