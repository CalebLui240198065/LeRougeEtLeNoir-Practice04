<?xml version="1.0" encoding="utf-8"?>
<!-- Provide compass buttons as a second way to steer the swipe-controlled Snake board. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_paper"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="13dp">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/Widget.RougeNoir.IconButton.Dark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/cream" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/nunito_bold"
                    android:letterSpacing="0.16"
                    android:text="@string/snake_eyebrow"
                    android:textColor="@color/gold_light"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/cormorant_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/snake_title"
                    android:textColor="@color/cream"
                    android:textSize="31sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/nunito_regular"
                    android:text="@string/snake_subtitle"
                    android:textColor="@color/parchment"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/content_description_snake_art"
                android:scaleType="fitCenter"
                android:src="@drawable/art_serpent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/snake_score_label"
                        android:textColor="@color/brown"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/snakeScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:fontFamily="@font/cormorant_bold"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="27sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/snake_best_label"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/snakeBest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        app:fontFamily="@font/cormorant_bold"
                        android:text="0"
                        android:textColor="@color/brown"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/snakeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:fontFamily="@font/nunito_regular"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/snake_ready"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <com.rougenoir.app.ui.view.SnakeView
                android:id="@+id/snakeView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/snake_board_description"
                android:minHeight="200dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_control_plate"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3">

                    <ImageButton
                        android:id="@+id/snakeUp"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_dpad_button"
                        android:contentDescription="@string/snake_up"
                        android:padding="10dp"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/brown" />

                    <ImageButton
                        android:id="@+id/snakeLeft"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_row="1"
                        android:layout_column="0"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_dpad_button"
                        android:contentDescription="@string/snake_left"
                        android:padding="10dp"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/brown" />

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_row="1"
                        android:layout_column="1"
                        android:layout_margin="2dp"
                        app:fontFamily="@font/cormorant_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="T"
                        android:textColor="@color/brown"
                        android:textSize="22sp" />

                    <ImageButton
                        android:id="@+id/snakeRight"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_row="1"
                        android:layout_column="2"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_dpad_button"
                        android:contentDescription="@string/snake_right"
                        android:padding="10dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/brown" />

                    <ImageButton
                        android:id="@+id/snakeDown"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_row="2"
                        android:layout_column="1"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_dpad_button"
                        android:contentDescription="@string/snake_down"
                        android:padding="10dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/brown" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.08"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/snake_control_hint"
                        android:textColor="@color/brown"
                        android:textSize="8sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        app:fontFamily="@font/nunito_regular"
                        android:text="@string/snake_control_note"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/snakeActionButton"
                style="@style/Widget.RougeNoir.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/snake_begin" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
