<?xml version="1.0" encoding="utf-8"?>
<!-- Every round shows the game, outcome, game-specific facts, and completion metadata. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/historyRoundTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RougeNoir.Label"
        android:textColor="@color/red_dark" />

    <TextView
        android:id="@+id/historyOutcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.RougeNoir.Title" />

    <TextView
        android:id="@+id/historyRoundDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.RougeNoir.Body" />

    <TextView
        android:id="@+id/historyRoundMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.RougeNoir.Caption" />
</LinearLayout>
