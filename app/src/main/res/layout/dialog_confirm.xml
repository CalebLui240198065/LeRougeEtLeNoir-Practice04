<?xml version="1.0" encoding="utf-8"?>
<!-- The settings screen fills in the prompt and action for each confirmation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/confirmEyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:fontFamily="@font/nunito_bold"
        android:letterSpacing="0.14"
        android:text="@string/settings_confirm_eyebrow"
        android:textColor="@color/brown"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/confirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:fontFamily="@font/cormorant_semibold"
        android:textColor="@color/ink"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/confirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:fontFamily="@font/nunito_regular"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmCancelButton"
            style="@style/Widget.RougeNoir.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textSize="10sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmActionButton"
            style="@style/Widget.RougeNoir.Button.Red"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
