<?xml version="1.0" encoding="utf-8"?>
<!-- The Study groups the local profile, feedback switches, difficulty, and original scores. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <ScrollView
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_paper"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <ImageButton
                    android:id="@+id/backButton"
                    style="@style/Widget.RougeNoir.IconButton.Dark"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/cream" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_bold"
                        android:letterSpacing="0.18"
                        android:text="@string/settings_eyebrow"
                        android:textColor="@color/gold_light"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/cormorant_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/settings_title"
                        android:textColor="@color/cream"
                        android:textSize="38sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_regular"
                        android:text="@string/settings_subtitle"
                        android:textColor="@color/parchment"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:contentDescription="@string/content_description_settings_art"
                    android:scaleType="fitCenter"
                    android:src="@drawable/art_study" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                app:fontFamily="@font/nunito_bold"
                android:letterSpacing="0.16"
                android:text="@string/settings_identity_label"
                android:textColor="@color/brown"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/settingsUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/nunito_semibold"
                    android:textColor="@color/brown"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:fontFamily="@font/nunito_bold"
                    android:labelFor="@id/displayNameInput"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_display_name_hint"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/displayNameInput"
                    style="@style/Widget.RougeNoir.Input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:hint="@string/settings_display_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="28" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/saveIdentityButton"
                        style="@style/Widget.RougeNoir.Button"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/settings_save_identity"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/changePasswordButton"
                        style="@style/Widget.RougeNoir.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/settings_change_password"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                app:fontFamily="@font/nunito_bold"
                android:letterSpacing="0.16"
                android:text="@string/settings_rules_label"
                android:textColor="@color/brown"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_dot_red"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_sound"
                        app:tint="@color/cream" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_semibold"
                            android:text="@string/settings_sound_title"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_regular"
                            android:text="@string/settings_sound_desc"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/soundSwitch"
                        style="@style/Widget.RougeNoir.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_sound_title" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_dot_black"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_vibrate"
                        app:tint="@color/cream" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_semibold"
                            android:text="@string/settings_haptics_title"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_regular"
                            android:text="@string/settings_haptics_desc"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/hapticsSwitch"
                        style="@style/Widget.RougeNoir.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_haptics_title" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="@color/line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:fontFamily="@font/nunito_bold"
                    android:letterSpacing="0.09"
                    android:text="@string/settings_difficulty_label"
                    android:textColor="@color/ink"
                    android:textSize="9sp" />

                <RadioGroup
                    android:id="@+id/difficultyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/difficultyEasy"
                        style="@style/Widget.RougeNoir.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/settings_difficulty_easy" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/difficultyMedium"
                        style="@style/Widget.RougeNoir.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/settings_difficulty_medium" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/difficultyHard"
                        style="@style/Widget.RougeNoir.RadioButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="@string/settings_difficulty_hard" />
                </RadioGroup>

                <TextView
                    android:id="@+id/difficultyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    app:fontFamily="@font/nunito_regular"
                    android:text="@string/settings_difficulty_medium_desc"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                app:fontFamily="@font/nunito_bold"
                android:letterSpacing="0.16"
                android:text="@string/settings_ledger_label"
                android:textColor="@color/brown"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_pill"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.06"
                            android:text="@string/settings_record_ttt"
                            android:textColor="@color/brown"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/settingsTttWins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/ink"
                            android:textSize="25sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_pill"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.06"
                            android:text="@string/settings_record_draws"
                            android:textColor="@color/brown"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/settingsTttDraws"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/ink"
                            android:textSize="25sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_pill"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.06"
                            android:text="@string/settings_record_snake"
                            android:textColor="@color/brown"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/settingsSnakeBest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/ink"
                            android:textSize="25sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_pill"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/nunito_bold"
                            android:letterSpacing="0.06"
                            android:text="@string/settings_record_breakout"
                            android:textColor="@color/brown"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/settingsBreakoutBest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:fontFamily="@font/cormorant_bold"
                            android:text="0"
                            android:textColor="@color/ink"
                            android:textSize="25sp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/resetRecordsButton"
                    style="@style/Widget.RougeNoir.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_reset_records"
                    android:textColor="@color/red"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                app:fontFamily="@font/nunito_bold"
                android:letterSpacing="0.16"
                android:text="@string/settings_about_label"
                android:textColor="@color/brown"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/art_study" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:fontFamily="@font/nunito_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/settings_about"
                        android:textColor="@color/ink_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:fontFamily="@font/cormorant_semibold"
                        android:text="@string/settings_about_small"
                        android:textColor="@color/brown"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/signOutButton"
                style="@style/Widget.RougeNoir.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:text="@string/settings_sign_out"
                android:textColor="@color/red"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="30dp"
                app:fontFamily="@font/nunito_regular"
                android:gravity="center"
                android:letterSpacing="0.09"
                android:text="@string/settings_version"
                android:textColor="@color/muted_light"
                android:textSize="8sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
